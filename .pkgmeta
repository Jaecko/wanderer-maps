# BigWigs packager: the zip is the addon folder "WandererMaps", the changelog of the version is CHANGELOG.md
# (written at each release from the full changelog).
package-as: WandererMaps

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md

# Shown on CurseForge: Wanderer Maps needs Wanderer.
required-dependencies:
  - wanderer
